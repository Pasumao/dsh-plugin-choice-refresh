{
  "name": "dsh-plugin-choice-refresh",
  "description": "DSH 选择增强插件（生态唯一）：给 ask_user_question / ask_user_choice 的选择卡加「重新生成选项 / 更多选项」两个按钮——选项都不满意一键换一批（换角度/维度，5~8 个），选项太少一键补充到 6~10 个。纯前端交互实现，不改核心包、不新增工具，原生文字卡与图片选择卡通吃。",
  "version": "0.1.3",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "设计说明.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasumao/dsh-plugin-choice-refresh.git"
  },
  "homepage": "https://github.com/Pasumao/dsh-plugin-choice-refresh",
  "bugs": {
    "url": "https://github.com/Pasumao/dsh-plugin-choice-refresh/issues"
  },
  "scripts": {
    "selfcheck": "node scripts/selfcheck.mjs",
    "smoke": "node scripts/selfcheck.mjs && node scripts/smoke-client.mjs",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "choice",
    "refresh",
    "regenerate-options",
    "more-options",
    "ask-user",
    "question",
    "ux",
    "chat-ui",
    "frontend",
    "options"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
